<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Counter.Views.CounterPage"
             Title="CounterPage">
    <Grid RowDefinitions="Auto, *">

        <HorizontalStackLayout Grid.Row="0" Padding="10" Spacing="10">
            <Entry
                x:Name="CounterNameEntry"
                Placeholder="Nazwa licznika"
                WidthRequest="200" />
            <Button
                Text="Dodaj"
                Clicked="AddCounter" />
        </HorizontalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Counters}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border 
                        Stroke="Black" 
                        StrokeThickness="1" 
                        Padding="10"
                        Margin="10"
                        WidthRequest="180">

                        <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, *" RowSpacing="5" ColumnSpacing="5">
                            <Label
                                Grid.Row="0"
                                Grid.ColumnSpan="2"
                                Text="{Binding Name}"
                                HorizontalTextAlignment="Center"
                                FontSize="20" />
                            <Label
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Text="{Binding CounterValue}"
                                HorizontalTextAlignment="Center"
                                FontSize="30" />

                            <Button
                                Grid.Row="2"
                                Grid.Column="0"
                                Text="-"
                                FontSize="20"
                                Clicked="CounterDecrease"/>
                            <Button
                                Grid.Row="2"
                                Grid.Column="1"
                                Text="+"
                                FontSize="20"
                                Clicked="CounterIncrease"/>
                        </Grid>

                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>